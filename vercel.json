{
    "version": 2,
    "env": {
        "DATABASE_URL": "@database_url",
        "NEXT_PUBLIC_STRIPE_KEY": "@stripe_public_key",
        "RESEND_API_KEY": "@resend_api_key"
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        }
    ],
    "functions": {
        "src/app/api/**/*.ts": {
            "memory": 1024,
            "maxDuration": 10
        }
    }
}